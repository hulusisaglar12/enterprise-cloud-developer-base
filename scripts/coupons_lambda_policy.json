{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCloudWatchLogsForCoupons",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:*:*:log-group:/aws/lambda/coupons*",
        "arn:aws:logs:*:*:log-group:/aws/lambda/coupons*:*"
      ]
    },
    {
      "Sid": "AllowDynamoDBForCouponsTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/coupons",
        "arn:aws:dynamodb:*:*:table/coupons/index/*"
      ]
    },
    {
      "Sid": "AllowS3ForCouponsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::coupons.idealtrip.com/*"
      ]
    }
  ]
}
